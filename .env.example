# Copy to .env and adjust. docker compose reads .env automatically.

# App database. Omit entirely to use the local SQLite file (the default).
# Postgres via the compose stack, connecting from your host:
DATABASE_URL=postgresql+psycopg://sdip:sdip@localhost:5432/sdip

# Postgres credentials used by docker-compose.yml
POSTGRES_USER=sdip
POSTGRES_PASSWORD=sdip
POSTGRES_DB=sdip

# Host port mapped to Postgres 5432
POSTGRES_PORT=5432

# Host port mapped to the app's 8080 (8001 matches the existing container)
APP_PORT=8001

# Environment. "production" turns off the demo conveniences below by default:
# the credential-free sign-in routes, demo seed data, and create_all.
APP_ENV=development

# Individual overrides (each defaults from APP_ENV; set to true/false to force).
# DEMO_AUTH=true
# SEED_DEMO_DATA=true
# AUTO_CREATE_TABLES=true

# Comma-separated origins allowed to call the API cross-origin. Outside
# production, localhost on any port is allowed automatically.
# CORS_ALLOW_ORIGINS=https://app.example.com
